# DOT OS boot splash. Layout: design-system/boards/Plymouth.dc.html.
# Wordmark, 20 segments and a percentage, bottom-left at a 32px margin.
# While progress is unknown (shutdown, or before the first estimate) a single
# red segment steps along the bar instead.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

PAD = 32;
NSEG = 20;
SEGW = 14;
GAP = 2;
BARW = NSEG * SEGW + (NSEG - 1) * GAP;

X0 = Window.GetX();
Y0 = Window.GetY();
W = Window.GetWidth();
H = Window.GetHeight();

mode = Plymouth.GetMode();
if (mode == "shutdown")
    label_image = Image("label-stopping.png");
else if (mode == "reboot")
    label_image = Image("label-restarting.png");
else if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade")
    label_image = Image("label-updating.png");
else
    label_image = Image("label-starting.png");

# Bottom up: label row, 8px, bar, 32px, wordmark.
label_y = Y0 + H - PAD - label_image.GetHeight();
bar_y = label_y - 8 - 16;
wordmark = Image("wordmark.png");
wordmark_y = bar_y - 32 - wordmark.GetHeight();

wordmark_sprite = Sprite(wordmark);
wordmark_sprite.SetPosition(X0 + PAD, wordmark_y, 1);

label_sprite = Sprite(label_image);
label_sprite.SetPosition(X0 + PAD, label_y, 1);

footer = Image("footer.png");
footer_sprite = Sprite(footer);
footer_sprite.SetPosition(X0 + W - PAD - footer.GetWidth(), Y0 + H - PAD - footer.GetHeight(), 1);

seg_on = Image("seg-on.png");
seg_off = Image("seg-off.png");
seg_live = Image("seg-live.png");
for (i = 0; i < NSEG; i++) {
    segs[i] = Sprite(seg_off);
    segs[i].SetPosition(X0 + PAD + i * (SEGW + GAP), bar_y, 1);
}

for (d = 0; d < 10; d++)
    digit[d] = Image("digit-" + d + ".png");
pct = Image("digit-pct.png");
DW = digit[0].GetWidth();
pct_sprite = Sprite(pct);
pct_sprite.SetPosition(X0 + PAD + BARW - pct.GetWidth(), label_y, 1);
for (i = 0; i < 3; i++) {
    num[i] = Sprite(digit[0]);
    num[i].SetPosition(X0 + PAD + BARW - pct.GetWidth() - (3 - i) * DW, label_y, 1);
    num[i].SetOpacity(0);
}

known = 0;

fun show_percent(value) {
    hundreds = Math.Int(value / 100);
    tens = Math.Int(value / 10) % 10;
    ones = value % 10;
    num[0].SetImage(digit[hundreds]);
    num[1].SetImage(digit[tens]);
    num[2].SetImage(digit[ones]);
    num[0].SetOpacity(hundreds > 0);
    num[1].SetOpacity(hundreds > 0 || tens > 0);
    num[2].SetOpacity(1);
    pct_sprite.SetOpacity(1);
}

fun set_progress(progress) {
    lit = Math.Int(progress * NSEG + 0.5);
    if (lit < 1) lit = 1;
    if (lit > NSEG) lit = NSEG;
    for (i = 0; i < NSEG; i++) {
        if (i < lit - 1) segs[i].SetImage(seg_on);
        else if (i == lit - 1) segs[i].SetImage(seg_live);
        else segs[i].SetImage(seg_off);
    }
    show_percent(Math.Int(progress * 100));
}

fun boot_progress(duration, progress) {
    known = 1;
    set_progress(progress);
}
Plymouth.SetBootProgressFunction(boot_progress);

# Indeterminate: one red segment steps along, ten steps a second.
pct_sprite.SetOpacity(0);
tick = 0;
step = 0;
fun refresh() {
    if (known) return;
    tick++;
    if (tick % 5 != 0) return;
    for (i = 0; i < NSEG; i++) segs[i].SetImage(seg_off);
    segs[step % NSEG].SetImage(seg_live);
    step++;
}
Plymouth.SetRefreshFunction(refresh);

# Disk unlock: the Input component, above the wordmark.
prompt_y = wordmark_y - 48 - 40;
password_label = Sprite(Image("label-password.png"));
password_label.SetPosition(X0 + PAD, prompt_y, 2);
password_label.SetOpacity(0);
underline = Sprite(Image("underline.png"));
underline.SetPosition(X0 + PAD, prompt_y + 40, 2);
underline.SetOpacity(0);
caret = Sprite(Image("caret.png"));
caret.SetOpacity(0);
bullet_image = Image("bullet.png");
MAXB = 28;
for (i = 0; i < MAXB; i++) {
    bullets[i] = Sprite(bullet_image);
    bullets[i].SetPosition(X0 + PAD + i * bullet_image.GetWidth(), prompt_y + 18, 2);
    bullets[i].SetOpacity(0);
}

fun display_normal() {
    password_label.SetOpacity(0);
    underline.SetOpacity(0);
    caret.SetOpacity(0);
    for (i = 0; i < MAXB; i++) bullets[i].SetOpacity(0);
}

fun display_password(prompt, count) {
    password_label.SetOpacity(1);
    underline.SetOpacity(1);
    shown = count;
    if (shown > MAXB) shown = MAXB;
    for (i = 0; i < MAXB; i++) bullets[i].SetOpacity(i < shown);
    caret.SetPosition(X0 + PAD + shown * bullet_image.GetWidth() + 2, prompt_y + 17, 2);
    caret.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);

# Messages (fsck, "Press Ctrl+C to cancel") in the label line's place; plain
# text, since the initramfs fonts are whatever Plymouth found.
message_sprite = Sprite();
message_sprite.SetPosition(X0 + PAD, Y0 + PAD, 2);
fun show_message(text) {
    message_sprite.SetImage(Image.Text(text, 0.6, 0.6, 0.6));
}
Plymouth.SetMessageFunction(show_message);

fun quit() {
    for (i = 0; i < NSEG; i++) segs[i].SetImage(seg_on);
    if (known) show_percent(100);
}
Plymouth.SetQuitFunction(quit);
