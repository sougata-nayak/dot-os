+// DOT OS: the details view follows the design system's Table. Every column
+// after the name is set in the mono face, and the kind is a small capital label.
+static QFont dotInfoFont(const QFont &base, const QByteArray &role)
+{
+    QFont font(QStringLiteral("Space Mono"));
+    font.setStyleHint(QFont::Monospace);
+    if (role == "type") {
+        font.setPointSizeF(base.pointSizeF() * 11.0 / 14.0);
+        font.setLetterSpacing(QFont::PercentageSpacing, 108);
+    } else {
+        font.setPointSizeF(base.pointSizeF() * 13.0 / 14.0);
+    }
+    return font;
+}
+
