Description: Draw the partition step in DOT OS greys
 Partition colours from the design system instead of the Breeze rainbow (new
 partitions by role: system white, EFI grey, swap dark grey), a flat
 segmented bar, a readable legend with flat squares, and no option artwork.
Author: DOT OS project
Forwarded: no
Last-Update: 2026-11-14
---
diff --git a/src/modules/partition/core/ColorUtils.cpp b/src/modules/partition/core/ColorUtils.cpp
index 6dc17be..d992bad 100644
--- a/src/modules/partition/core/ColorUtils.cpp
+++ b/src/modules/partition/core/ColorUtils.cpp
@@ -28,25 +28,43 @@ using Calamares::Partition::isPartitionFreeSpace;
 using Calamares::Partition::isPartitionNew;
 using Calamares::Partition::PartitionIterator;
 
-static const int NUM_PARTITION_COLORS = 5;
-static const int NUM_NEW_PARTITION_COLORS = 4;
-//Let's try to use the Breeze palette
+// DOT OS: greys from the design system (dark theme) instead of the Breeze
+// rainbow, as on design-system/boards/Installer.dc.html. Existing
+// partitions step through greys; new ones are coloured by what they are
+// (see newPartitionColor()).
+static const int NUM_PARTITION_COLORS = 4;
+static const int NUM_NEW_PARTITION_COLORS = 3;
 static const QColor PARTITION_COLORS[ NUM_PARTITION_COLORS ] = {
-    "#2980b9",  //Dark Plasma Blue
-    "#27ae60",  //Dark Icon Green
-    "#c9ce3b",  //Dirty Yellow
-    "#3daee9",  //Plasma Blue
-    "#9b59b6",  //Purple
+    "#999999",  // text-secondary
+    "#E8E8E8",  // text-primary
+    "#666666",  // text-disabled
+    "#CCCCCC",
 };
 static const QColor NEW_PARTITION_COLORS[ NUM_NEW_PARTITION_COLORS ] = {
-    "#c0392b",  //Dark Icon Red
-    "#f39c1f",  //Dark Icon Yellow
-    "#f1b7bc",  //Light Salmon
-    "#fed999",  //Light Orange
+    "#FFFFFF",  // text-display
+    "#999999",  // text-secondary
+    "#666666",  // text-disabled
 };
-static QColor FREE_SPACE_COLOR = "#777777";
-static QColor EXTENDED_COLOR = "#aaaaaa";
-static QColor UNKNOWN_DISKLABEL_COLOR = "#4d4151";
+static QColor FREE_SPACE_COLOR = "#222222";  // border
+static QColor EXTENDED_COLOR = "#333333";  // border-visible
+static QColor UNKNOWN_DISKLABEL_COLOR = "#1A1A1A";  // surface-raised
+
+// The board's legend: the EFI system partition in text-secondary, swap in
+// text-disabled, everything else (the system itself) in text-display.
+static QColor
+newPartitionColor( Partition* partition )
+{
+    const auto type = partition->fileSystem().type();
+    if ( type == FileSystem::LinuxSwap )
+    {
+        return NEW_PARTITION_COLORS[ 2 ];
+    }
+    if ( type == FileSystem::Fat32 || type == FileSystem::Fat16 || type == FileSystem::Fat12 )
+    {
+        return NEW_PARTITION_COLORS[ 1 ];
+    }
+    return NEW_PARTITION_COLORS[ 0 ];
+}
 
 static QMap< QString, QColor > s_partitionColorsCache;
 
@@ -140,7 +158,8 @@ colorForPartition( Partition* partition )
 
     if ( isPartitionNew( partition ) )
     {
-        return NEW_PARTITION_COLORS[ newColorIdx % NUM_NEW_PARTITION_COLORS ];
+        Q_UNUSED( newColorIdx )
+        return newPartitionColor( partition );
     }
 
     if ( partition->fileSystem().supportGetUUID() != FileSystem::cmdSupportNone
@@ -184,7 +203,9 @@ colorForPartitionInFreeSpace( Partition* partition )
             ++newColorIdx;
         }
     }
-    return NEW_PARTITION_COLORS[ newColorIdx % NUM_NEW_PARTITION_COLORS ];
+    // The new system's own partition: always the hero colour.
+    Q_UNUSED( newColorIdx )
+    return NEW_PARTITION_COLORS[ 0 ];
 }
 
 
