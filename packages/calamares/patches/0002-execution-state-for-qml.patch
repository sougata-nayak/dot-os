diff --git a/src/libcalamaresui/viewpages/ExecutionViewStep.h b/src/libcalamaresui/viewpages/ExecutionViewStep.h
index df52e55..b4445a5 100644
--- a/src/libcalamaresui/viewpages/ExecutionViewStep.h
+++ b/src/libcalamaresui/viewpages/ExecutionViewStep.h
@@ -27,6 +27,52 @@ namespace Calamares
 
 class Slideshow;
 
+/**
+ * @brief Install progress for QML (DOT OS)
+ *
+ * Registered as the singleton "Execution" in io.calamares.ui, so the
+ * slideshow and the navigation panel can draw the install step themselves:
+ * the progress (0..1), the current status message, whether the log is
+ * showing, and a way to show or hide it.
+ */
+class UIDLLEXPORT ExecutionState : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY( qreal progress READ progress NOTIFY progressChanged FINAL )
+    Q_PROPERTY( QString message READ message NOTIFY progressChanged FINAL )
+    Q_PROPERTY( bool active READ active NOTIFY activeChanged FINAL )
+    Q_PROPERTY( bool logVisible READ logVisible NOTIFY logVisibleChanged FINAL )
+
+public:
+    static ExecutionState* instance();
+
+    qreal progress() const { return m_progress; }
+    QString message() const { return m_message; }
+    bool active() const { return m_active; }
+    bool logVisible() const { return m_logVisible; }
+
+    void setProgress( qreal progress, const QString& message );
+    void setActive( bool active );
+    void setLogVisible( bool visible );
+
+    /// Ask the install step to show or hide its log.
+    Q_INVOKABLE void toggleLog();
+
+signals:
+    void progressChanged();
+    void activeChanged();
+    void logVisibleChanged();
+    void toggleLogRequested();
+
+private:
+    explicit ExecutionState( QObject* parent = nullptr );
+
+    qreal m_progress = 0;
+    QString m_message;
+    bool m_active = false;
+    bool m_logVisible = false;
+};
+
