 namespace Calamares
 {
 
+ExecutionState::ExecutionState( QObject* parent )
+    : QObject( parent )
+{
+}
+
+ExecutionState*
+ExecutionState::instance()
+{
+    // Never deleted: QML engines hold on to it for the life of the program.
+    static ExecutionState* s_instance = new ExecutionState;
+    return s_instance;
+}
+
+void
+ExecutionState::setProgress( qreal progress, const QString& message )
+{
+    m_progress = progress;
+    if ( !message.isEmpty() )
+    {
+        m_message = message;
+    }
+    emit progressChanged();
+}
+
+void
+ExecutionState::setActive( bool active )
+{
+    if ( active != m_active )
+    {
+        m_active = active;
+        emit activeChanged();
+    }
+}
+
+void
+ExecutionState::setLogVisible( bool visible )
+{
+    if ( visible != m_logVisible )
+    {
+        m_logVisible = visible;
+        emit logVisibleChanged();
+    }
+}
+
+void
+ExecutionState::toggleLog()
+{
+    emit toggleLogRequested();
+}
