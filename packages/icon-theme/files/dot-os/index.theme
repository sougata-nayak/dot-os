[Icon Theme]
Name=DOT OS
Comment=Monoline icons at a 1.5px stroke, drawn from Lucide
Inherits=breeze-dark,breeze,hicolor
Example=folder
FollowsColorScheme=true
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256
Directories=apps/scalable,places/scalable,devices/scalable,actions/scalable,status/scalable,mimetypes/scalable,categories/scalable,emblems/scalable,apps/large,places/large,devices/large,mimetypes/large,categories/large,apps/scalable@2,places/scalable@2,devices/scalable@2,actions/scalable@2,status/scalable@2,mimetypes/scalable@2,categories/scalable@2,emblems/scalable@2,apps/large@2,places/large@2,devices/large@2,mimetypes/large@2,categories/large@2,apps/scalable@3,places/scalable@3,devices/scalable@3,actions/scalable@3,status/scalable@3,mimetypes/scalable@3,categories/scalable@3,emblems/scalable@3,apps/large@3,places/large@3,devices/large@3,mimetypes/large@3,categories/large@3

