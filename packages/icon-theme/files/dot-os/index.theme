[Icon Theme]
Name=DOT OS
Comment=Monoline icons at a 1.5px stroke, drawn from Lucide
Inherits=breeze-dark,breeze,hicolor
Example=folder
FollowsColorScheme=true
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256
Directories=apps/scalable,places/scalable,devices/scalable,actions/scalable,status/scalable,mimetypes/scalable,categories/scalable,emblems/scalable,apps/large,places/large,devices/large,mimetypes/large,categories/large

