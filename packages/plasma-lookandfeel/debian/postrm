#!/bin/sh
set -e
#DEBHELPER#
D=/usr/share/plasma/shells/org.kde.plasma.desktop/contents
A=/usr/share/applications/kcm_lookandfeel.desktop
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
	for f in lockscreen/LockScreen.qml osd/Osd.qml; do
		dpkg-divert --package dot-os-plasma-lookandfeel --remove --rename --divert "$D/$f.plasma" "$D/$f" >/dev/null || true
	done
	dpkg-divert --package dot-os-plasma-lookandfeel --remove --rename --divert /etc/skel/.face.debian /etc/skel/.face >/dev/null || true
	dpkg-divert --package dot-os-plasma-lookandfeel --remove --rename --divert "$A.dotos-locked" "$A" >/dev/null || true
fi
