#!/bin/sh
# DOT OS is a lightweight desktop. Plasma recommends apps that DOT OS does not
# ship: duplicates of something already there (a second browser and terminal,
# an old search tool) or extras that also run at every login (phone pairing,
# backups). Remove them, and whatever only they pulled in, from the image.
# Installed systems are copied from this image, so they leave it too.
# Users can still install any of them with apt.
set -e

remove="
konqueror
zutty
kfind
kdeconnect
kup-backup
plasma-welcome
khelpcenter
kmenuedit
plasma-vault
plasma-firewall
plasma-browser-integration
webext-plasma-browser-integration
xwaylandvideobridge
"

# The image must stay under GitHub's 2 GiB limit for a release file.
# Firmware for hardware no arm64 desktop has: datacenter network cards and
# GPUs, telephony and TV-tuner cards, and Wi-Fi from x86-era laptops. Firmware
# for Snapdragon and Raspberry Pi boards, Wi-Fi, Bluetooth and desktop GPUs
# stays.
remove="$remove
firmware-netronome
firmware-nvidia-tesla-535-gsp
firmware-marvell-prestera
firmware-cavium
firmware-qlogic
firmware-myricom
firmware-bnx2x
firmware-bnx2
firmware-netxen
dahdi-firmware-nonfree
firmware-ivtv
firmware-siano
firmware-ipw2x00
firmware-libertas
"

# Noto's extra weights and second copies of scripts. Every script still has
# a font: the core, CJK, emoji and mono Noto sets stay (marked below so the
# autoremove does not take them with the extras).
remove="$remove
fonts-noto
fonts-noto-extra
fonts-noto-ui-extra
fonts-noto-cjk-extra
"

# Keep the man command, which only came in through the removed apps, and the
# core fonts, which came in through fonts-noto.
apt-mark manual man-db fonts-noto-core fonts-noto-ui-core fonts-noto-cjk \
	fonts-noto-mono fonts-noto-color-emoji >/dev/null

# shellcheck disable=SC2086
DEBIAN_FRONTEND=noninteractive apt-get purge -y --autoremove $remove

# Kvantum Manager ships in the same package as the Kvantum engine that draws
# every DOT OS widget, so it stays installed; it is only taken off the menus.
if [ -f /usr/share/applications/kvantummanager.desktop ]; then
	mkdir -p /usr/local/share/applications
	sed '/^\[Desktop Entry\]/a NoDisplay=true' /usr/share/applications/kvantummanager.desktop \
		> /usr/local/share/applications/kvantummanager.desktop
fi
